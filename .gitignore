# P10_GameplayLint repository: docs + the UE project in GameplayLint/.
# Generated by Unreal / Visual Studio. Never commit.
GameplayLint/Binaries/
GameplayLint/Intermediate/
GameplayLint/Saved/
GameplayLint/DerivedDataCache/
GameplayLint/Build/
GameplayLint/Plugins/*/Binaries/
GameplayLint/Plugins/*/Intermediate/
GameplayLint/.vs/
GameplayLint/*.sln
GameplayLint/*.slnx
*.VC.db
*.opensdf
*.sdf
*.suo

# Python
__pycache__/

# Packaged builds stay out of git.
Build/

# Benchmarks: raw captures, run reports and logs stay local (too large for git; UE logs also hold
# machine-specific paths). Manifests and Summaries/ are committed; cited raw batches go to GitHub Releases.
Benchmarks/Raw/*
!Benchmarks/Raw/*_manifest.json
Benchmarks/*_console.txt

# The seeded test corpus is regenerated from its seed by Tools/seed.py and never committed (01 section 7.1).
GameplayLint/Content/GLSeed/
GameplayLint/Config/Tags/GLSeed*.ini

# Work-in-progress drafts (brief section 2 rule 11): parked here, never committed.
_wip/
